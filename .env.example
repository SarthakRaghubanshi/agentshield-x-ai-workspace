# AI Workspace settings. Copy this file to .env and fill in only what you use:
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# Restart the server after editing. Never commit .env (it is in .gitignore).

# ---- Online models (optional) ----
# Set one or more keys; the matching models become selectable in the console.
# Paid usage is capped by budget.max_usd in config/workspace.yaml (default USD 2 per process).
# Google AI Studio, free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq, free tier, very fast: https://console.groq.com/keys
GROQ_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# one key for many providers: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Any other LiteLLM provider works too: set its key here (name as in the LiteLLM docs) and type
# the model string in the console ("Other LiteLLM model string") or add it to config/models.yaml.

# ---- Local models when running `python -m aiworkspace serve` directly ----
OLLAMA_API_BASE=http://localhost:11434
VLLM_API_BASE=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLAMACPP_API_BASE=http://localhost:8080/v1

# ---- Local models when running with docker compose (as seen from inside the container) ----
# Defaults point at the host machine. With the bundled Ollama container use http://ollama:11434
# DOCKER_OLLAMA_API_BASE=http://host.docker.internal:11434
# DOCKER_VLLM_API_BASE=http://host.docker.internal:8001/v1
# DOCKER_LLAMACPP_API_BASE=http://host.docker.internal:8080/v1

# ---- Optional PostgreSQL telemetry instead of SQLite (PRD FR-21) ----
# Local:  TELEMETRY_DB_URL=postgresql://user:password@localhost:5432/telemetry
# Docker: TELEMETRY_DB_URL=postgresql://agentshield:agentshield@postgres:5432/telemetry
#         then: docker compose --profile postgres up --build
# TELEMETRY_DB_URL=

# ---- Attach the AgentShield-X security layer (comma separated module:function) ----
# AGENTSHIELD_PLUGINS=examples.example_guard:register
