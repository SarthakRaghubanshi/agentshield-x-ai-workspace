# Copy to .env and fill in only what you use. Never commit .env.
# Cloud models (optional; spend is capped by budget.max_usd in config/workspace.yaml)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local models (OpenAI-compatible endpoints)
# Running `python -m aiworkspace serve` directly:   http://localhost:11434
# Inside docker compose with Ollama on the host:     http://host.docker.internal:11434
# Inside docker compose with --profile ollama:       http://ollama:11434
OLLAMA_API_BASE=http://localhost:11434
VLLM_API_BASE=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLAMACPP_API_BASE=http://localhost:8080/v1

# Attach the AgentShield-X security layer (comma separated module:function)
# AGENTSHIELD_PLUGINS=examples.example_guard:register
