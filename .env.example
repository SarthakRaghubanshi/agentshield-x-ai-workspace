# Copy to .env and fill in only what you use. Never commit .env.

# ---- Cloud models (optional; spend is capped by budget.max_usd in config/workspace.yaml) ----
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Local models when running `python -m aiworkspace serve` directly ----
OLLAMA_API_BASE=http://localhost:11434
VLLM_API_BASE=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLAMACPP_API_BASE=http://localhost:8080/v1

# ---- Local models when running with docker compose (as seen from inside the container) ----
# Defaults point at the host machine. With the bundled Ollama container use http://ollama:11434
# DOCKER_OLLAMA_API_BASE=http://host.docker.internal:11434
# DOCKER_VLLM_API_BASE=http://host.docker.internal:8001/v1
# DOCKER_LLAMACPP_API_BASE=http://host.docker.internal:8080/v1

# ---- Attach the AgentShield-X security layer (comma separated module:function) ----
# AGENTSHIELD_PLUGINS=examples.example_guard:register
